rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Online multiplayer game rooms accessible across devices via room code
    match /game_rooms/{roomId} {
      allow read, write: if true;
    }
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
